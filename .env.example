# Backend (read from the environment; docker-compose.yml sets working values for local use)
DATABASE_URL=postgresql://app:app@localhost:5432/convai
# Full agent invocation URL. Leave empty to get mock replies.
AGENT_URL=

# Sign-in check (spec 008). All three are required; the backend won't start without them.
# Token issuer ("iss" claim). Local Keycloak shown; for Okta use https://<tenant>.okta.com/oauth2/<server-id>
OIDC_ISSUER=http://localhost:8081/realms/convai
# Audience this API accepts ("aud" claim)
OIDC_AUDIENCE=convai-api
# Where the identity provider publishes its public keys. Inside docker compose the host is keycloak:8081
OIDC_JWKS_URL=http://localhost:8081/realms/convai/protocol/openid-connect/certs

# Access to AI planning (spec 009). A stand-in until the business supplies real rules: the token's
# boolean "ai_planning" claim decides; a missing claim means education only.
# Comma-separated user ids ("sub") or usernames always refused, whatever the claim says.
ENTITLEMENT_DENY=
# "unavailable" forces education-only mode for everyone (to try that path); default "claim".
ENTITLEMENT_MODE=claim

# Web app sign-in settings (spec 009) are in frontend/apps/web/.env.example.
