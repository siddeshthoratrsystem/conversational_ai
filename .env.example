# Backend (read from the environment; docker-compose.yml sets working values for local use)
DATABASE_URL=postgresql://app:app@localhost:5432/convai
# Full agent invocation URL. Leave empty to get mock replies.
AGENT_URL=

# Sign-in check (spec 008). All three are required; the backend won't start without them.
# Token issuer ("iss" claim). Local stand-in shown; for Okta use https://<tenant>.okta.com/oauth2/<server-id>
OIDC_ISSUER=http://localhost:8090/default
# Audience this API accepts ("aud" claim)
OIDC_AUDIENCE=convai-api
# Where the identity provider publishes its public keys. Inside docker compose this is http://oidc:8090/default/jwks
OIDC_JWKS_URL=http://localhost:8090/default/jwks

# Access to AI planning (spec 009). A stand-in until the business supplies real rules: the token's
# boolean "ai_planning" claim decides; a missing claim means education only.
# Comma-separated user ids ("sub") or usernames always refused, whatever the claim says.
ENTITLEMENT_DENY=
# "unavailable" forces education-only mode for everyone (to try that path); default "claim".
ENTITLEMENT_MODE=claim

# Web app (Vite). Where the sign-in page gets a token from the local stand-in.
VITE_OIDC_TOKEN_URL=http://localhost:8090/default/token

# Action gate (spec 011). Demo defaults, not Principal policy; each can be left unset.
# Seconds a staged change can be confirmed after it is shown.
ACTION_EXPIRY_SECONDS=300
# Comma-separated replies that count as confirming or cancelling (matched exactly, ignoring case and punctuation).
ACTION_CONFIRM_REPLIES=confirm
ACTION_CANCEL_REPLIES=cancel
# Allowed 401(k) contribution rate range, in percent (inclusive).
CONTRIBUTION_MIN_PCT=0
CONTRIBUTION_MAX_PCT=50
# Only whole percentages are accepted when true.
CONTRIBUTION_WHOLE_PCT_ONLY=true
