{
  "name": "convai-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "web": "npm run dev -w @convai/web",
    "mobile": "npm run start -w @convai/mobile",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "tokens": "npm run generate -w @convai/tokens",
    "bundle:mobile": "npm run bundle -w @convai/mobile",
    "e2e": "npm run e2e -w @convai/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
