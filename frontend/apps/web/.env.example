# Sign-in (spec 009). Copy to .env.local to override.
# Issuer URL and public client id. For Okta, change these two and register the redirect URIs.
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/convai
VITE_OIDC_CLIENT_ID=convai-web
VITE_OIDC_SCOPE=openid profile
# Idle sign-out and how long before it the warning shows.
VITE_IDLE_TIMEOUT_MINUTES=15
VITE_IDLE_WARNING_MINUTES=2
